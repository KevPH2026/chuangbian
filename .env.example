# 后台口令。部署到生产环境时必须设置，否则 /admin 不会开放。
ADMIN_TOKEN=change-me

# 用来加密后台保存的模型 API Key。开源部署建议单独设置，不要频繁更换。
CONFIG_ENCRYPTION_KEY=change-me-long-random-string

# 存储模式：
# - blob：使用 Vercel Blob
# - github：使用 GitHub data 分支，适合 Blob 被限额暂停时兜底
# - memory：只存在当前进程内，适合本地调界面
CHUANGBIAN_STORAGE=blob

# Vercel Blob：用于保存图库、用户上传头像、许愿墙、后台模型配置。
BLOB_READ_WRITE_TOKEN=vercel-blob-token

# GitHub 存储：只在 CHUANGBIAN_STORAGE=github 时需要。
CHUANGBIAN_GITHUB_REPO=owner/repo
CHUANGBIAN_GITHUB_BRANCH=chuangbian-data
CHUANGBIAN_GITHUB_DIR=data
CHUANGBIAN_GITHUB_TOKEN=github-token-with-repo-write

# 本地只想跑界面、不连接 Blob 时可临时使用：
# CHUANGBIAN_STORAGE=memory npm run dev

# 关闭“后台模型配置”时，生成接口会回退到这些环境变量。
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.tokenrouter.com/v1
OPENAI_IMAGE_MODEL=openai/gpt-5.4-image-2
OPENAI_IMAGE_SIZE=256x256
OPENAI_IMAGE_QUALITY=low
